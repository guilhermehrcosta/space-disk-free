{
  "sourceLanguage": "en",
  "strings": {
    "%@ available": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ disponíveis"
          }
        }
      }
    },
    "%@ freed in %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ freed in %2$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ liberados em %2$@"
          }
        }
      }
    },
    "%@ is a protected folder and can't be removed.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é uma pasta protegida e não pode ser removida."
          }
        }
      }
    },
    "%@ moved to the Trash": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ movidos para a Lixeira"
          }
        }
      }
    },
    "%@ reclaimable": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recuperáveis"
          }
        }
      }
    },
    "%@ will be moved to the Trash.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ serão movidos para a Lixeira."
          }
        }
      }
    },
    "%@ will be permanently deleted.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ serão apagados permanentemente."
          }
        }
      }
    },
    "%@ will be permanently deleted. This can't be undone.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ serão apagados permanentemente. Não é possível desfazer."
          }
        }
      }
    },
    "%lld items in use or protected were kept": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld itens em uso ou protegidos foram mantidos"
          }
        }
      }
    },
    "Also removes every image no container uses (downloaded again when needed) and the whole build cache. Volumes are kept.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Também remove todas as imagens que nenhum container usa (serão baixadas de novo) e todo o cache de build. Volumes são mantidos."
          }
        }
      }
    },
    "Analyze": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisar"
          }
        }
      }
    },
    "Analyze again": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisar novamente"
          }
        }
      }
    },
    "Android emulator images (%lld installed). They can be downloaded again from the SDK Manager.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens dos emuladores Android (%lld instaladas). Podem ser baixadas de novo pelo SDK Manager."
